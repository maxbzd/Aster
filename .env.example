# Aster works fully offline with no configuration. Fill these in only if you want
# multi-device sync, server-side AI keys, TickTick, or the MCP server (see docs/CLOUD.md).

# Your own Supabase project (Project Settings -> API).
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_KEY=sb_publishable_...

# Force-disable the cloud even when the two variables above are set:
# VITE_CLOUD=off
