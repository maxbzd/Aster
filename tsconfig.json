{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": false,
    "types": [
      "vite/client",
      "vite-plugin-pwa/client",
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "exclude": [
    "supabase/functions/ai/index.ts",
    "supabase/functions/ticktick/index.ts",
    "supabase/functions/mcp/index.ts"
  ],
  "include": [
    "src",
    "api",
    "supabase/functions",
    "tests",
    "vitest.config.ts"
  ]
}
