{
  "name": "aster",
  "private": true,
  "version": "1.0.0",
  "description": "Aster: an open-source, local-first personal CRM for networking. People, meetings, reminders and an assistant that remembers everyone. English and Russian.",
  "license": "MIT",
  "author": "Aster contributors",
  "homepage": "https://github.com/maxbzd/Aster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxbzd/Aster.git"
  },
  "bugs": {
    "url": "https://github.com/maxbzd/Aster/issues"
  },
  "keywords": [
    "crm",
    "personal-crm",
    "networking",
    "pwa",
    "local-first",
    "offline-first",
    "react",
    "typescript",
    "indexeddb",
    "i18n",
    "ai-assistant",
    "mcp"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src api tests",
    "lint:fix": "biome lint --write src api tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size": "node scripts/check-size.mjs",
    "check": "npm run typecheck && npm run lint && npm run i18n:check && npm run test && npm run build && npm run size",
    "eval": "node --env-file=.env.eval node_modules/vitest/vitest.mjs run tests/eval --reporter=basic",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.118.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^20.14.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
